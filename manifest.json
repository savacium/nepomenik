{
  "manifest_version": 3,
  "name": "nepomenik",
  "version": "0.2.1",
  "description": "Zamagljuje lice Aleksandra Vučića u YouTube plejeru kanala @ParlamentSrbija.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-mask": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Uključi ili pauziraj nepomenik"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "channel.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "vendor/face-api.min.js",
        "recognition.js",
        "tracking.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/models/*",
        "reference.json"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
